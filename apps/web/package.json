{
  "name": "my-expo-app",
  "version": "1.0.0",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "export:ota": "expo export --output-dir dist-ota && node -e \"const fs=require('fs'); const app=require('./app.json'); fs.writeFileSync('dist-ota/expoConfig.json', JSON.stringify(app.expo, null, 2));\"",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "export BROWSER=none && expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/react-native-charts-wrapper": "^0.5.11",
    "axios": "^1.18.1",
    "daisyui": "^5.6.18",
    "expo": "~56.0.19",
    "expo-camera": "~56.0.8",
    "expo-checkbox": "~56.0.1",
    "expo-constants": "~56.0.24",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.23",
    "expo-localization": "~56.0.6",
    "expo-location": "~56.0.23",
    "expo-network": "~56.0.5",
    "expo-router": "~56.2.18",
    "expo-secure-store": "~56.0.4",
    "expo-sensors": "~56.0.6",
    "expo-splash-screen": "~56.0.14",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-task-manager": "~56.0.25",
    "expo-updates": "~56.0.25",
    "i18next": "^26.3.6",
    "lucide-react": "^1.25.0",
    "lucide-react-native": "^1.31.0",
    "maplibre-gl": "^5.24.0",
    "nativewind": "preview",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.81.0",
    "react-i18next": "^17.0.11",
    "react-leaflet": "^5.0.0",
    "react-map-gl": "^8.1.1",
    "react-native": "0.85.3",
    "react-native-chart-kit": "^7.0.2",
    "react-native-charts-wrapper": "^0.7.0",
    "react-native-css": "latest",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "^5.8.1",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.13",
    "typescript": "~6.0.3"
  },
  "main": "expo-router/entry",
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "private": true
}