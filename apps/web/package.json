{
  "name": "my-expo-app",
  "version": "1.0.0",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "export:ota": "expo export --output-dir dist-ota --platform android --platform ios && node -e \"const fs=require('fs'); const app=require('./app.json'); fs.writeFileSync('dist-ota/expoConfig.json', JSON.stringify(app.expo, null, 2));\"",
    "build:eas-android": "NODE_ENV=production eas build --platform android --profile preview --local",
    "build:eas-ios": "NODE_ENV=production eas build --platform ios --profile preview --local",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "export BROWSER=none && expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react-native-charts-wrapper": "^0.5.11",
    "axios": "^1.18.1",
    "expo": "~57.0.15",
    "expo-camera": "~57.0.4",
    "expo-checkbox": "~57.0.0",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.15",
    "expo-file-system": "^57.0.5",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.12",
    "expo-intent-launcher": "^57.0.1",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.12",
    "expo-network": "~57.0.1",
    "expo-notifications": "^57.0.15",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.12",
    "expo-updates": "~57.0.16",
    "i18next": "^26.3.6",
    "lucide-react-native": "^1.31.0",
    "maplibre-gl": "^5.24.0",
    "nativewind": "preview",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.81.0",
    "react-i18next": "^17.0.11",
    "react-map-gl": "^8.1.1",
    "react-native": "0.86.2",
    "react-native-charts-wrapper": "^0.7.0",
    "react-native-css": "latest",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "babel-preset-expo": "^57.0.7",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~57.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "main": "expo-router/entry",
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "private": true
}