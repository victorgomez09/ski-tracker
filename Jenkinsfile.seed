pipeline {
    agent any

    parameters {
        string(
            name: 'RESORT_TARGET',
            defaultValue: 'Valdesquí',
            description: 'Nombre o parte del nombre de la estación a simular'
        )
        string(
            name: 'API_BASE_URL',
            defaultValue: 'http://api:8080',
            description: 'URL base de la API (ej: http://api:8080 si corre en la red Docker, o https://api-ski-tracker.viti-tech.es)'
        )
        string(
            name: 'DB_HOST',
            defaultValue: 'postgres',
            description: 'Host de PostgreSQL (ej: postgres dentro de la red Docker, o localhost)'
        )
        string(
            name: 'DB_PORT',
            defaultValue: '5432',
            description: 'Puerto de PostgreSQL (5432 dentro de Docker, o 5433 en host)'
        )
        string(
            name: 'DB_NAME',
            defaultValue: 'ski_tracker',
            description: 'Nombre de la base de datos'
        )
        string(
            name: 'DB_USER',
            defaultValue: 'ski_tracker',
            description: 'Usuario de PostgreSQL'
        )
        string(
            name: 'DOCKER_NETWORK',
            defaultValue: 'deploy_default',
            description: 'Red Docker de compose donde conviven postgres y api'
        )
        string(
            name: 'SEED_USER_EMAIL',
            defaultValue: 'admin@admin.es',
            description: 'Email del usuario para iniciar la sesión de esquí'
        )
        password(
            name: 'SEED_USER_PASSWORD',
            defaultValue: 'adminadmin',
            description: 'Contraseña del usuario seed'
        )
    }

    environment {
        DEPLOY_DIR = 'deploy'
    }

    stages {
        stage('Resolve Secrets') {
            steps {
                script {
                    try {
                        withCredentials([
                            string(credentialsId: 'ski-tracker-db-password', variable: 'CRED_DB_PASSWORD')
                        ]) {
                            env.DB_PASSWORD = CRED_DB_PASSWORD
                        }
                    } catch (err) {
                        echo 'Info: Credencial "ski-tracker-db-password" no encontrada en Jenkins. Leyendo deploy/.env...'
                        if (fileExists('deploy/.env')) {
                            def envPass = sh(
                                script: "grep '^DB_PASSWORD=' deploy/.env | cut -d '=' -f2- | tr -d '\"' | tr -d \"'\" || true",
                                returnStdout: true
                            ).trim()
                            env.DB_PASSWORD = envPass ?: 'ski_tracker'
                        } else {
                            env.DB_PASSWORD = 'ski_tracker'
                        }
                    }
                }
            }
        }

        stage('Execute Simulation') {
            steps {
                echo "🎿 Ejecutando simulación de esquí para '${params.RESORT_TARGET}' en red '${params.DOCKER_NETWORK}'..."
                sh """
                    docker run --rm \
                        --network ${params.DOCKER_NETWORK} \
                        -v "\$PWD":/app \
                        -w /app \
                        -e RESORT_TARGET="${params.RESORT_TARGET}" \
                        -e API_BASE_URL="${params.API_BASE_URL}" \
                        -e DB_HOST="${params.DB_HOST}" \
                        -e DB_PORT="${params.DB_PORT}" \
                        -e DB_NAME="${params.DB_NAME}" \
                        -e DB_USER="${params.DB_USER}" \
                        -e DB_PASSWORD="\${DB_PASSWORD}" \
                        -e SEED_USER_EMAIL="${params.SEED_USER_EMAIL}" \
                        -e SEED_USER_PASSWORD="${params.SEED_USER_PASSWORD}" \
                        -e PYTHONUNBUFFERED="1" \
                        python:3.11-slim \
                        bash -c "pip install -q psycopg2-binary requests && python3 seed/seed-database.py"
                """
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo '🎉 ¡Simulación del día de esquí completada con éxito!'
        }
        failure {
            echo '❌ Error durante la simulación. Revisa la traza de logs.'
        }
    }
}
